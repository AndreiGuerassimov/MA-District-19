{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1184px"
		},
		"viewport": {
			"mobile": "600px",
			"tablet": "1100px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"color": "#F8F5EC",
					"name": "Cream"
				},
				{
					"slug": "base-alt",
					"color": "#F3EEDF",
					"name": "Cream Deep"
				},
				{
					"slug": "surface",
					"color": "#FFFDF6",
					"name": "Surface"
				},
				{
					"slug": "ink",
					"color": "#21372C",
					"name": "Ink"
				},
				{
					"slug": "primary",
					"color": "#2F5D47",
					"name": "Forest"
				},
				{
					"slug": "primary-dark",
					"color": "#1F3E31",
					"name": "Forest Deep"
				},
				{
					"slug": "accent",
					"color": "#B0521F",
					"name": "Terracotta"
				},
				{
					"slug": "accent-bright",
					"color": "#CE5F35",
					"name": "Terracotta Bright"
				},
				{
					"slug": "body",
					"color": "#44584C",
					"name": "Body Text"
				},
				{
					"slug": "muted",
					"color": "#5B6E61",
					"name": "Muted Text"
				},
				{
					"slug": "on-dark",
					"color": "#C8D4C4",
					"name": "Text on Forest"
				},
				{
					"slug": "on-dark-muted",
					"color": "#8FA98D",
					"name": "Muted on Forest"
				},
				{
					"slug": "sand",
					"color": "#F0D9A8",
					"name": "Sand"
				},
				{
					"slug": "success",
					"color": "#3F8A5F",
					"name": "Success"
				},
				{
					"slug": "on-accent",
					"color": "#FFF7EE",
					"name": "Text on Terracotta"
				}
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Hero Wash",
					"gradient": "linear-gradient(180deg, #F8F5EC 0%, #F3EEDF 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Lora",
					"fontFamily": "Lora, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/lora-normal-latin.woff2"
							]
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/lora-normal-latin-ext.woff2"
							]
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/lora-italic-latin.woff2"
							]
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/lora-italic-latin-ext.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Karla",
					"fontFamily": "Karla, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Karla",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/karla-normal-latin.woff2"
							]
						},
						{
							"fontFamily": "Karla",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/karla-normal-latin-ext.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Tiny 11",
					"size": "11px",
					"fluid": false
				},
				{
					"slug": "xx-small",
					"name": "Eyebrow 12",
					"size": "12px",
					"fluid": false
				},
				{
					"slug": "x-small",
					"name": "Micro 13",
					"size": "13px",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small 14",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body 16",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Lede 18",
					"size": "18px",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading 22",
					"size": "22px",
					"fluid": {
						"min": "20px",
						"max": "22px"
					}
				},
				{
					"slug": "xx-large",
					"name": "Section 30",
					"size": "30px",
					"fluid": {
						"min": "24px",
						"max": "30px"
					}
				},
				{
					"slug": "quote",
					"name": "Quote 34",
					"size": "34px",
					"fluid": {
						"min": "24px",
						"max": "34px"
					}
				},
				{
					"slug": "display",
					"name": "Display 46",
					"size": "46px",
					"fluid": {
						"min": "32px",
						"max": "46px"
					}
				},
				{
					"slug": "display-lg",
					"name": "Display 52",
					"size": "52px",
					"fluid": {
						"min": "34px",
						"max": "52px"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1 — 8",
					"size": "8px"
				},
				{
					"slug": "20",
					"name": "2 — 12",
					"size": "12px"
				},
				{
					"slug": "30",
					"name": "3 — 16",
					"size": "16px"
				},
				{
					"slug": "40",
					"name": "4 — 20",
					"size": "20px"
				},
				{
					"slug": "50",
					"name": "5 — 24",
					"size": "24px"
				},
				{
					"slug": "60",
					"name": "6 — 32",
					"size": "32px"
				},
				{
					"slug": "70",
					"name": "7 — 40",
					"size": "40px"
				},
				{
					"slug": "80",
					"name": "8 — 48",
					"size": "48px"
				},
				{
					"slug": "90",
					"name": "9 — 56",
					"size": "56px"
				},
				{
					"slug": "100",
					"name": "10 — 64",
					"size": "64px"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Subtle",
					"shadow": "0 1px 2px rgba(33, 55, 44, 0.15)"
				},
				{
					"slug": "md",
					"name": "Lifted",
					"shadow": "0 8px 24px rgba(33, 55, 44, 0.14)"
				},
				{
					"slug": "lg",
					"name": "Floating",
					"shadow": "0 12px 32px rgba(33, 55, 44, 0.12)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": {
				"sm": "9px",
				"md": "12px",
				"lg": "16px",
				"pill": "999px",
				"round": "50%"
			},
			"lineHeight": {
				"tight": "1.15",
				"heading": "1.35",
				"body": "1.65",
				"list": "2.1"
			},
			"letterSpacing": {
				"caps": "0.25em"
			},
			"hairline": {
				"color": "rgba(33, 55, 44, 0.1)",
				"strong": "rgba(33, 55, 44, 0.2)",
				"on-dark": "rgba(200, 212, 196, 0.2)"
			},
			"measure": {
				"narrow": "52ch",
				"base": "62ch",
				"wide": "70ch"
			},
			"focus": {
				"width": "2px",
				"offset": "2px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--80)",
				"right": "var(--wp--preset--spacing--80)"
			},
			"blockGap": "var(--wp--preset--spacing--50)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display-lg)",
					"lineHeight": "var(--wp--custom--line-height--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"textDecoration": "none"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"spacing": {
					"padding": {
						"top": "15px",
						"bottom": "15px",
						"left": "28px",
						"right": "28px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--ink)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "17px",
					"fontWeight": "600",
					"lineHeight": "1.1"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--custom--hairline--color)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/navigation-link": {
				"typography": {
					"lineHeight": "1.75"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				},
				"-current": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"border": {
						"bottom": {
							"color": "var(--wp--preset--color--accent-bright)",
							"width": "2px",
							"style": "solid"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "navigation-overlay",
			"name": "navigation-overlay",
			"title": "Navigation Overlay"
		}
	]
}
