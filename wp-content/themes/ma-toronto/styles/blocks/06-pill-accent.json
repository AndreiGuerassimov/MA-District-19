{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"slug": "pill-accent",
	"title": "Accent Pill",
	"blockTypes": [ "core/button" ],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|on-accent"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|on-accent"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|ink",
						"text": "var:preset|color|on-accent"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|ink",
						"style": "solid",
						"width": "var:custom|focus|width",
						"offset": "var:custom|focus|offset"
					}
				}
			}
		}
	}
}
