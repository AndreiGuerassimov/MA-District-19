{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"slug": "eyebrow",
	"title": "Eyebrow",
	"blockTypes": [ "core/paragraph", "core/heading" ],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|xx-small",
			"fontWeight": "700",
			"lineHeight": "1.2",
			"letterSpacing": "var:custom|letter-spacing|caps",
			"textTransform": "uppercase"
		}
	}
}
