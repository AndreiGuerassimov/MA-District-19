{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"slug": "arrow-link",
	"title": "Arrow Link",
	"blockTypes": [ "core/paragraph" ],
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|x-small",
			"fontWeight": "700",
			"lineHeight": "1.3"
		},
		"color": { "text": "var:preset|color|accent" },
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var:preset|color|accent" },
					"typography": { "textDecoration": "underline" }
				}
			}
		}
	}
}
